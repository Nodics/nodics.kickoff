# Copy this file to `.env` and update the path for your machine.
#
# The path may be absolute or relative to this Kickoff project root.
# It must point to the Nodics framework checkout folder that contains module
# groups such as nodics.foundation, nodics.platform, nodics.wcms, and nodics.cron.
#
# Example framework workspace:
NODICS_FRAMEWORK_ROOT=../nodics.ai

# Repository build scratch space used by framework clean/build gates.
# Keep this path writable by the process user in local and server deployments.
NODICS_REPOSITORY_BUILD_TMPDIR=.nodics/tmp

{
  "name": "commerceServer",
  "version": "0.0.0",
  "index": "1001.16",
  "private": true,
  "main": "nodics.js",
  "description": "Reference customer full Commerce server.",
  "nodics": {
    "runtimeConfigurationContributions": [
      {
        "moduleName": "eWaste",
        "namespace": "digitalCore"
      }
    ],
    "kind": "server",
    "extends": [
      "nodics.commerce",
      "nodics.accelerators",
      "nodics.loyalty"
    ],
    "runtimeModule": true,
    "loadableByNodicsModuleLoader": true,
    "owns": [
      "configuration",
      "llm"
    ],
    "runtime": {
      "router": false,
      "publish": false,
      "web": false
    },
    "displayName": "Commerce Server",
    "runtimeIdentity": {
      "instanceCode": "kickoff-local-commerce-1",
      "remoteModules": [
        "profile",
        "backoffice",
        "loyaltyCore",
        "loyaltyApi",
        "wasteCore",
        "media",
        "eWaste",
        "wasteCarbon",
        "workflow",
        "commsApi"
      ]
    },
    "runtimeTooling": {
      "code": "commerce",
      "script": "start:commerce",
      "order": 9,
      "readinessTimeoutMs": 300000
    },
    "runtimeAliases": [
      "loyalty"
    ],
    "runtimeModuleRoots": [
      "nodics.discovery",
      "nodics.commerce",
      "nodics.accelerators",
      "nodics.loyalty"
    ]
  }
}

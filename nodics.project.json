{
  "contractVersion": 0,
  "projectCode": "nodics.kickoff",
  "displayName": "Nodics Kickoff",
  "projectType": "reference",
  "framework": {
    "rootProperty": "NODICS_FRAMEWORK_ROOT",
    "minimumContractVersion": 1,
    "upgradePolicy": "framework-owned-tooling-project-owned-facts"
  },
  "applications": {
    "backends": [
      "platform",
      "wcmsStaged",
      "wcmsOnline",
      "process",
      "engagement",
      "commerce",
      "commerceStaged"
    ],
    "frontends": [
      "axis",
      "nexus",
      "agora"
    ]
  },
  "domains": [
    "apparel",
    "electronics",
    "telco"
  ],
  "dataPacks": [
    "nexus.web",
    "agora.apparel",
    "agora.electronics",
    "agora.telco"
  ],
  "runtime": {
    "servers": {
      "platform": {
        "environment": "kickoffLocal",
        "server": "platformServer",
        "moduleRoots": [
          "nodics.foundation",
          "nodics.localization",
          "nodics.platform",
          "{project}"
        ]
      },
      "wcms": {
        "retired": true,
        "retiredMessage": [
          "The combined Local WCMS runtime is retired.",
          "Use `npm run start:wcms:staged` for authoring and publication source operations,",
          "or `npm run start:wcms:online` for delivery and publication target operations.",
          "The legacy configuration and database are retained temporarily as rollback evidence; they are not runtime authorities."
        ]
      },
      "wcmsStaged": {
        "environment": "kickoffLocal",
        "server": "wcmsStagedServer",
        "moduleRoots": [
          "nodics.foundation",
          "nodics.wcms",
          "nodics.platform",
          "{project}"
        ]
      },
      "wcmsOnline": {
        "environment": "kickoffLocal",
        "server": "wcmsOnlineServer",
        "moduleRoots": [
          "nodics.foundation",
          "nodics.wcms",
          "{project}"
        ]
      },
      "process": {
        "environment": "kickoffLocal",
        "server": "processServer",
        "moduleRoots": [
          "nodics.foundation",
          "nodics.process",
          "nodics.wcms",
          "{project}"
        ]
      },
      "engagement": {
        "environment": "kickoffLocal",
        "server": "engagementServer",
        "moduleRoots": [
          "nodics.foundation",
          "nodics.communication",
          "nodics.engagement",
          "{project}"
        ]
      },
      "commerce": {
        "environment": "kickoffLocal",
        "server": "commerceServer",
        "moduleRoots": [
          "nodics.foundation",
          "nodics.process",
          "nodics.discovery",
          "nodics.commerce",
          "nodics.accelerators",
          "{project}"
        ]
      },
      "commerceStaged": {
        "environment": "kickoffLocal",
        "server": "commerceStagedServer",
        "moduleRoots": [
          "nodics.foundation",
          "nodics.process",
          "nodics.discovery",
          "nodics.commerce",
          "nodics.accelerators",
          "{project}"
        ]
      }
    }
  },
  "acceptance": {
    "functionalJourney": {
      "reason": "Kickoff functional acceptance",
      "runtimes": {
        "platform": {
          "label": "Platform",
          "port": 4300,
          "script": "start:platform"
        },
        "commerce": {
          "label": "Commerce",
          "port": 4350,
          "script": "start:commerce"
        },
        "engagement": {
          "label": "Engagement",
          "port": 4340,
          "script": "start:engagement"
        }
      }
    },
    "capabilityRegistry": {
      "foundationModule": "nodics.foundation",
      "retiredModule": "nodics.core",
      "functionalModule": "nodics.process",
      "observedServer": "kickoffLocal:processServer:default"
    },
    "guidedInitialization": {
      "profileCode": "localWcmsFoundation",
      "publicationProfiles": [
        "nexus",
        "nexusupdate",
        "nexusecosystemrepair",
        "agoraapparel",
        "agoraelectronics",
        "agoratelco"
      ],
      "deliveryProbe": {
        "site": "nexusCorporateSite",
        "path": "/",
        "locale": "en",
        "channel": "web"
      }
    }
  },
  "topology": {
    "environment": "kickoffLocal",
    "stateDirectory": "envs/kickoffLocal/generated/local-topology",
    "groups": {
      "backends": [
        {
          "code": "platform",
          "label": "Platform",
          "script": "start:platform",
          "port": 4300
        },
        {
          "code": "wcmsOnline",
          "label": "WCMS Online",
          "script": "start:wcms:online",
          "port": 4314
        },
        {
          "code": "process",
          "label": "Process and Automation",
          "script": "start:process",
          "port": 4330
        },
        {
          "code": "wcmsStaged",
          "label": "WCMS Staged",
          "script": "start:wcms:staged",
          "port": 4312
        },
        {
          "code": "engagement",
          "label": "Engagement",
          "script": "start:engagement",
          "port": 4340
        },
        {
          "code": "commerceStaged",
          "label": "Commerce Staged",
          "script": "start:commerce:staged",
          "port": 4352
        },
        {
          "code": "commerce",
          "label": "Commerce",
          "script": "start:commerce",
          "port": 4350
        }
      ],
      "frontends": [
        {
          "code": "axis",
          "label": "Axis",
          "command": "npm",
          "args": [
            "run",
            "dev"
          ],
          "cwd": "{workspaceRoot}/nodics.exp/nodics.axis",
          "port": 3100,
          "readyPath": "/"
        },
        {
          "code": "nexus",
          "label": "Nexus",
          "command": "npm",
          "args": [
            "run",
            "dev"
          ],
          "cwd": "{workspaceRoot}/nodics.exp/nodics.nexus",
          "port": 3200,
          "readyPath": "/"
        },
        {
          "code": "agora",
          "label": "Agora Apparel",
          "command": "npm",
          "args": [
            "run",
            "dev",
            "--",
            "--host",
            "127.0.0.1",
            "--port",
            "3300"
          ],
          "cwd": "{workspaceRoot}/nodics.exp/nodics.agora.apparel",
          "port": 3300,
          "readyPath": "/"
        }
      ]
    }
  },
  "containerEnvironments": {
    "dockerLocal": {
      "environment": "kickoffDockerLocal",
      "qualificationClass": "LOCAL_PRODUCTION_SIMULATION",
      "composeProjectName": "nodics-kickoff-docker-local",
      "composeFile": "envs/kickoffDockerLocal/docker/compose.yaml",
      "generatedDirectory": "envs/kickoffDockerLocal/generated",
      "environmentFile": "docker.env",
      "replicaSet": "nodicsDockerLocal",
      "mongodbHost": "mongodb",
      "redisPrimaryHost": "redis-primary",
      "bootstrapAdminPassword": "NodicsLocal@2026",
      "hostPorts": [
        4100,
        4200,
        5300,
        5312,
        5314,
        5330,
        5340,
        5350
      ],
      "nativeIsolationPorts": [
        3100,
        3200,
        4300,
        4312,
        4314,
        4330,
        4340,
        4350
      ],
      "resilience": {
        "backupDirectory": "envs/kickoffDockerLocal/generated/backups",

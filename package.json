    "test:qualification": "node test/deploymentQualificationContract.test.mjs && node test/dataLifecycleClassificationContract.test.mjs && node test/localPublishingContractFreeze.test.mjs && node test/localTopologyLifecycle.test.mjs && node test/dockerLocalEnvironmentContract.test.mjs && node test/dockerLocalResilienceContract.test.mjs",
    "test": "npm run quality:ownership && npm run test:documentation && npm run nexus:test && npm run test:qualification && npm run prepare:runtime",

    "configure:framework": "node -e \"const fs=require('fs'),path=require('path'),cp=require('child_process');const readEnv=()=>fs.existsSync('.env')?Object.fromEntries(fs.readFileSync('.env','utf8').split(/\\r?\\n/).map(l=>l.trim()).filter(l=>l&&!l.startsWith('#')&&l.includes('=')).map(l=>{const i=l.indexOf('=');return [l.slice(0,i).trim(),l.slice(i+1).trim().replace(/^['\\\"]|['\\\"]$/g,'')];})):{};const root=path.resolve(process.env.NODICS_FRAMEWORK_ROOT||readEnv().NODICS_FRAMEWORK_ROOT||'.nodics/framework');const tool=path.join(root,'nodics.foundation/modules/nTooling/bin/nodics-tool.js');const r=cp.spawnSync(process.execPath,[tool,'project:configure-framework','--home='+process.cwd()],{stdio:'inherit',env:{...process.env,NODICS_PROJECT_ROOT:process.cwd(),NODICS_FRAMEWORK_ROOT:root}});if(r.error)throw r.error;process.exit(r.status||0);\"",

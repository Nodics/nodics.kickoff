{
  "name": "nodics.kickoff",
  "version": "0.0.1",
  "index": "1000.00",
  "private": true,
  "description": "Reference customer project for running Nodics locally and demonstrating framework customization.",
  "main": "nodics.js",
  "nodics": {
    "kind": "application",
    "runtimeModule": true,
    "loadableByNodicsModuleLoader": true,
    "owns": [
      "composition",
      "configuration"
    ],
    "runtime": {
      "router": false,
      "publish": false,
      "web": false
    },
    "displayName": "Nodics Kickoff"
  },
  "dependencies": {
    "nodics.foundation": "file:.nodics/framework/nodics.foundation",
    "nodics.commerce": "file:.nodics/framework/nodics.commerce",
    "nodics.communication": "file:.nodics/framework/nodics.communication",
    "nodics.cron": "file:.nodics/framework/nodics.cron",
    "nodics.discovery": "file:.nodics/framework/nodics.discovery",
    "nodics.engagement": "file:.nodics/framework/nodics.engagement",
    "nodics.localization": "file:.nodics/framework/nodics.localization",
    "nodics.platform": "file:.nodics/framework/nodics.platform",
    "nodics.process": "file:.nodics/framework/nodics.process",
    "nodics.wcms": "file:.nodics/framework/nodics.wcms"
  },
  "scripts": {
    "configure:framework": "node src/sync-framework-dependencies.js",
    "docs:generate": "node scripts/generate-documentation-content.mjs",
    "docs:check": "node scripts/generate-documentation-content.mjs --check",
    "nexus:check": "npm run nexus:test",
    "nexus:test": "node modules/nexusData/test/nexusCorporateContentContract.test.mjs",
    "start:commerce": "node src/start-commerce-server.js",
    "start:commerce:staged": "node src/start-commerce-staged-server.js",
    "start:engagement": "node src/start-engagement-server.js",
    "start:platform": "node src/start-platform-server.js",
    "start:process": "node src/start-process-server.js",
    "start:wcms": "node src/start-wcms-server.js",
    "start:wcms:staged": "node src/start-wcms-staged-server.js",
    "start:wcms:online": "node src/start-wcms-online-server.js",
    "topology:start": "node scripts/local-topology.mjs start",
    "topology:start:all": "node scripts/local-topology.mjs start --include-frontends",
    "topology:preflight": "node scripts/local-topology.mjs preflight --include-frontends",
    "topology:status": "node scripts/local-topology.mjs status --include-frontends",
    "topology:stop": "node scripts/local-topology.mjs stop",
    "docker-local:preflight": "node scripts/docker-local.mjs preflight",
    "docker-local:build": "node scripts/docker-local.mjs build",
    "docker-local:start": "node scripts/docker-local.mjs start",
    "docker-local:status": "node scripts/docker-local.mjs status",
    "docker-local:logs": "node scripts/docker-local.mjs logs",
    "docker-local:stop": "node scripts/docker-local.mjs stop",
    "docker-local:reset": "node scripts/docker-local.mjs reset --confirm-destroy-docker-local-data",
    "docker-local:acceptance": "node scripts/docker-local-acceptance.mjs",
    "docker-local:qualify": "node scripts/docker-local-qualification.mjs",
    "docker-local:backup": "node scripts/docker-local-resilience.mjs backup",
    "docker-local:restore": "node scripts/docker-local-resilience.mjs restore",
    "docker-local:resilience": "node scripts/docker-local-resilience-qualification.mjs",
    "docker-local:publishing-interruption-contracts": "node scripts/docker-local-publishing-interruption-contracts.mjs",
    "docker-local:soak": "node scripts/docker-local-soak-qualification.mjs",
    "acceptance:local": "node scripts/local-bootstrap-acceptance.mjs",
    "acceptance:local:fresh": "node scripts/local-bootstrap-acceptance.mjs --drop-local-db",
    "acceptance:functional": "node scripts/functional-journey-acceptance.mjs",
    "acceptance:agora-commerce": "node scripts/agora-commerce-acceptance.mjs",
    "acceptance:agora-commerce-data": "node scripts/agora-commerce-data-acceptance.mjs",
    "acceptance:agora-commerce-publication": "node scripts/agora-commerce-publication-acceptance.mjs",
    "acceptance:editorial-live": "node scripts/editorial-live-journey-acceptance.mjs",
    "acceptance:capability-registry": "node scripts/capability-registry-acceptance.mjs",
    "acceptance:guided-initialization": "node scripts/guided-initialization-acceptance.mjs",
    "qualification:deployment": "node scripts/deployment-qualification.mjs",
    "qualification:deployment:local": "node scripts/deployment-qualification.mjs --execute-local",
    "qualification:publishing-capacity": "node scripts/publishing-capacity-baseline.mjs",
    "qualification:publishing-soak": "node scripts/local-sustained-publishing-qualification.mjs",
    "qualification:security-boundary": "node scripts/local-security-boundary-qualification.mjs",
    "quality:ownership": "node .nodics/framework/nodics.foundation/modules/nTooling/bin/nodics-tool.js quality:ownership --home=.",
    "prepare:platform": "node test/runtime-prepare.test.js platformServer",
    "prepare:runtime": "node test/runtime-prepare.test.js",
    "test:documentation": "npm run docs:check && node test/documentationContract.test.js",
    "test:qualification": "node test/deploymentQualificationContract.test.mjs && node test/dataLifecycleClassificationContract.test.mjs && node test/localPublishingContractFreeze.test.mjs && node test/localTopologyLifecycle.test.mjs && node test/dockerLocalEnvironmentContract.test.mjs && node test/dockerLocalResilienceContract.test.mjs",
    "test": "npm run quality:ownership && npm run test:documentation && npm run nexus:test && npm run test:qualification && npm run prepare:runtime"
  }
}
